# Copy to `.env` (gitignored). Compose passes these into the worker only when set.
# Leave unset to keep engine defaults (~3 GiB memo per heavy hand).

# FIRELINE_PORT=80
# FIRELINE_IMAGE_TAG=latest
# WORKER_CONCURRENCY=1
# API_CONCURRENCY=1

# Per-hand search memo budget (MiB). Default inside the worker is 3072 (~4M entries).
# Example for a ~40 GiB machine hunting pathological Oracle hands:
# GA_FIRE_HAND_MEM_MB=12288

# Optional: pin detected RAM / pressure thresholds (MiB).
# GA_FIRE_MEM_TOTAL_MB=40960
# GA_FIRE_MEM_RESERVE_MB=4096
# GA_FIRE_MEM_PARK_MB=2048

# RAYON_NUM_THREADS=4
# WORKER_LOG_RUNS=1
