:80 {
	handle_path /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	# Keep the /play and /solver prefixes — Next.js basePath expects them.
	handle /play* {
		reverse_proxy play:3000
	}

	handle /solver* {
		reverse_proxy web:3000
	}

	# Bare / and legacy root bookmarks → solver.
	handle {
		redir * /solver{uri} permanent
	}
}
