FROM node:22-bookworm-slim AS deps
WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/play/package.json ./apps/play/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/game/package.json ./packages/game/

RUN pnpm install --frozen-lockfile --filter @ga-fire/play...

FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN corepack enable

COPY --from=deps /app /app
COPY apps/play ./apps/play
COPY packages/contracts ./packages/contracts
COPY packages/game ./packages/game

ENV NEXT_TELEMETRY_DISABLED=1
# Baked into next.config rewrites at build time (runtime env alone is not enough).
ARG API_ORIGIN=http://api:8080
ENV API_ORIGIN=$API_ORIGIN

RUN mkdir -p apps/play/public \
  && pnpm --filter @ga-fire/play build

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    API_ORIGIN=http://api:8080

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/play/public ./apps/play/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/play/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/play/.next/static ./apps/play/.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "apps/play/server.js"]
