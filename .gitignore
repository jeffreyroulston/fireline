# dependencies
node_modules
**/node_modules
package-lock.json
.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/out/

# production
/build
/target

# misc
.DS_Store
*.pem

